# Server environment (copy to .env and adjust)

NODE_ENV=development
PORT=5000

# Client origin for CORS + OAuth redirects
CLIENT_URL=http://localhost:5173

# Local MongoDB (no Docker required in dev)
MONGODB_URI=mongodb://localhost:27017/autoparts_express

# JWT secrets (generate strong random values in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Comma-separated Google emails promoted to admin at sign-in
ADMIN_EMAILS=

# Stripe (test mode is free — get keys at https://dashboard.stripe.com/test/apikeys)
# Leave STRIPE_SECRET_KEY empty to run checkout in free "dev" mode (no real cards).
STRIPE_SECRET_KEY=
# pk_test_... — served to the client for Stripe Elements
STRIPE_PUBLISHABLE_KEY=
# whsec_... from `stripe listen --forward-to localhost:5000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=

# Cloudinary (product images)
CLOUDINARY_URL=
